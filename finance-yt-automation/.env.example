# Copy to `.env` and fill in. NEVER commit the real .env (it's gitignored).

# --- Anthropic (required) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Stock footage (optional; solid/gradient background is used without it) ---
#   Pexels:  https://www.pexels.com/api/
#   Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Higgsfield (optional) ---
# Put HF_KEY=key-id:key-secret in .env.local instead of here (see docs/HIGGSFIELD.md).

# --- YouTube upload (required for `upload`) ---
# OAuth "Desktop app" client JSON from Google Cloud Console. See docs/SETUP.md.
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
