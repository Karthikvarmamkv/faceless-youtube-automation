# Copy to `.env` and fill in. NEVER commit the real .env (it's gitignored).

# --- Anthropic (required) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Stock footage (optional, used by `generate` mode) ---
# Free keys:
#   Pexels:  https://www.pexels.com/api/
#   Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube upload (required for `upload`) ---
# You authenticate via OAuth (client_secret.json), not an env var. See docs/SETUP.md.
# This just points at where the OAuth client secret file lives:
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
